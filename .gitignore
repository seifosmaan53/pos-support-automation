# Dependencies / build output
node_modules
dist
dist-ssr
*.local
*.tsbuildinfo
coverage

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets — never commit
.env
.env.*
*.pem
*.key
*.cert
*.p12

# Tauri / Rust build output
src-tauri/target
src-tauri/gen

# Local app data — keep recordings + extracted state out of the repo
# NOTE: scoped with a leading slash — an unscoped "data/" also matches
# src/data/, which previously excluded real source files from every commit.
/data/
models/
audio/
exports/
backups/
*.sqlite
*.sqlite-journal
*.wav
*.bin

# Built macOS app bundles. Tauri writes releases into src-tauri/target/release/bundle/
# (already ignored above); a stray copy of the .app had been committed at the repo root,
# adding a 20 MB arm64-only binary to every clone. Build artifacts do not belong in git.
Store Ticket Assistant
Store Ticket Assistant.app/
*.app/
*.dmg
